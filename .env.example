# ==========================================
# GameLog Environment Configuration Template
# ==========================================
# Instruções:
# 1. Copie este arquivo para .env na raiz do projeto: cp .env.example .env
# 2. Preencha os valores abaixo para o seu ambiente local ou de homologação.
# 3. NUNCA comite arquivos .env com senhas reais ou chaves privadas no Git.

# Database Configuration (PostgreSQL 16)
DB_SERVER=postgres
DB_PORT=5432
DB_NAME=gamelog
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# Security & Authentication (Obrigatório: mínimo 32 caracteres / 256 bits)
# Dica de geração segura: openssl rand -base64 64
JWT_SECRET=your_super_secret_key_with_at_least_32_characters_long!
JWT_ISSUER=GameLogAPI
JWT_AUDIENCE=GameLogClient
JWT_EXPIRE_HOURS=24

# External APIs
# Obtenha sua chave gratuita em: https://rawg.io/apikeys
RAWG_API_KEY=
RAWG_BASE_URL=https://api.rawg.io/api

# Opcional: Chave de API do SteamGridDB para capas verticais HD (https://www.steamgriddb.com/profile/api)
# STEAMGRIDDB_API_KEY=

# CORS Configuration (origens permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Seeder & Catálogo Inicial (true para forçar recarga completa de catálogo no boot)
FORCE_RESEED=false
