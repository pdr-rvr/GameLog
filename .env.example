# ==============================================================================
# GameLog — Environment Variables Configuration Template
# ==============================================================================
# INSTRUÇÕES DE SEGURANÇA:
# 1. NUNCA comite credenciais ou senhas reais neste arquivo (.env.example).
# 2. Em ambiente LOCAL: copie este arquivo para '.env' e preencha com valores de desenvolvimento.
#    Exemplo: cp .env.example .env
# 3. Em ambiente CLOUD / PRODUÇÃO (AWS, Kubernetes, Azure, GCP):
#    - Utilize um Secrets Manager (ex: AWS Secrets Manager, HashiCorp Vault, K8s Secrets).
#    - Injete as variáveis de ambiente em tempo de execução via Task Definition / Pod Spec.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações de Ambiente & ASP.NET Core
# ------------------------------------------------------------------------------
# Valores recomendados: 'Development' (local), 'Staging' (homologação), 'Production' (produção)
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Host do banco: 'postgres' (rede interna Docker) ou 'localhost' / 'rds-endpoint.amazonaws.com'
DB_SERVER=postgres
DB_PORT=5432
DB_NAME=gamelog
DB_USER=postgres
# OBRIGATÓRIO: Senha forte para o banco de dados
DB_PASSWORD=TroqueEstaSenhaPorUmaForte123!

# ------------------------------------------------------------------------------
# 3. Segurança & Autenticação (JWT / Tokens)
# ------------------------------------------------------------------------------
# OBRIGATÓRIO: Chave secreta de no mínimo 32 caracteres (256 bits) para HMAC-SHA256
JWT_SECRET=ChaveSuperSecretaComMaisDe32CaracteresParaProducao!123

# Emissor e audiência dos tokens JWT
JWT_ISSUER=GameLogAPI
JWT_AUDIENCE=GameLogClient

# Tempo de expiração do JWT em minutos (padrão recomendado: 15 minutos)
JWT_EXPIRE_MINUTES=15

# Tempo de expiração do Refresh Token em dias (padrão: 7 dias)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. APIs Externas de Games
# ------------------------------------------------------------------------------
# Chave de API da RAWG (obtenha gratuitamente em https://rawg.io/apidocs)
RAWG_API_KEY=sua_chave_rawg_aqui

# ------------------------------------------------------------------------------
# 5. Segurança de Rede & CORS
# ------------------------------------------------------------------------------
# Origens permitidas separadas por vírgula (em produção: https://gamelog.seudominio.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. Governança & Retenção de Dados (Audit Trail)
# ------------------------------------------------------------------------------
# Quantidade de dias para expurgo automático de registros da tabela AuditLogs (padrão: 90)
AUDIT_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 7. Operações de Infraestrutura & Seeder
# ------------------------------------------------------------------------------
# ATENÇÃO: Deixe como 'false' em Produção para proteger os dados existentes.
FORCE_RESEED=false
